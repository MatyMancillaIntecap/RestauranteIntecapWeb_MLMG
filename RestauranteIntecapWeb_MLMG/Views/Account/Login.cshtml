@{
    Layout = null; // Indicamos que esta pantalla no usa la barra de navegación general del sistema
    ViewData["Title"] = "Iniciar Sesión - Restaurante INTECAP";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Importamos Bootstrap para diseño responsivo -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            /* ESTILOS PROFESIONALES PARA EL FONDO Y OVERLAY */
            body {
                margin: 0;
                padding: 0;
                height: 100vh;
                /* FORMA CORRECTA EN CSS: Usar url() apuntando a la ruta de la imagen */
                background-image: url('/images/logo_intecap/logo_fondo_intecap.png');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* Capa semitransparente oscura sobre la foto para resaltar la tarjeta */
            .login-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.5); /* Oscurece la foto un 50% */
                z-index: 1;
            }

            .login-card-container {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 420px;
                padding: 15px;
            }

            .card-custom {
                background: rgba(255, 255, 255, 0.95);
                border-radius: 1rem;
                box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.3);
            }
    </style>
</head>
<body>

    <!-- Capa oscura de fondo -->
    <div class="login-overlay"></div>

    <!-- Contenedor del Formulario -->
    <div class="login-card-container">
        <div class="card card-custom border-0 p-4">

            <!-- SECCIÓN DEL LOGOTIPO INTECAP -->
            <div class="text-center mb-3">
                <img src="~/images/logo_intecap/Logo-Azul-Intecap.png" alt="Logo INTECAP" style="max-height: 60px; object-fit: contain;" class="mb-2" />
               
                
                
                <!--<h3 class="fw-bold text-dark mb-1" style="font-size: 1.5rem;">Iniciar Sesión</h3>
                 <p class="text-muted small">Restaurante Escuela INTECAP</p> -->




            </div>

            <!-- FORMULARIO DE ACCESO -->
            <form asp-action="Login" method="post">

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Correo Electrónico</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light">👤</span>
                        <input type="email5" name="email" class="form-control" placeholder="admin@intecap.com" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Contraseña</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light">🔒</span>
                        <input type="password" name="password" class="form-control" placeholder="••••" required />
                    </div>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary fw-bold py-2" style="background-color: #1e68f7; border: none;">
                        ACCEDER / LOG IN
                    </button>
                </div>

                <div class="text-center small">
                    <a href="#" class="text-decoration-none text-primary d-block mb-1">Restablecer Contraseña</a>




                    <!--  <a href="#" class="text-decoration-none text-muted">Unicamente para personal de INTECAP</a> -->





                </div>

            </form>
        </div>
    </div>

</body>
</html>