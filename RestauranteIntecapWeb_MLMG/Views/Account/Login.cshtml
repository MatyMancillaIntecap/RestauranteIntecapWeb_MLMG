@model RestauranteIntecapWeb_MLMG.Models.DTOs.LoginViewModel

@{
    Layout = null; // No utiliza la plantilla principal para control total de estilos
    ViewData["Title"] = "Iniciar Sesión - Restaurante Intecap";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- CSS de Bootstrap y Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
            /* Fondo gris suave de contraste para la tarjeta flotante */
            body {
                background-color: #a0a0a0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                margin: 0;
                padding: 15px;
            }

            /* Tarjeta flotante con bordes redondeados y sombra suave */
            .login-card {
                width: 100%;
                max-width: 420px;
                background: #f8f9fa;
                border: 2px solid #1e4b9e;
                border-radius: 24px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
                padding: 2.5rem 2rem;
                text-align: center;
            }

            /* Ajuste de tamaño para el logo de Intecap */
            .login-logo {
                max-width: 190px;
                height: auto;
                margin-bottom: 0.5rem;
            }

            .login-title {
                color: #10336b;
                font-weight: 800;
                font-size: 1.9rem;
                margin-bottom: 1.8rem;
            }

            /* Grupo de campos de texto con ícono interno */
            .input-group-custom {
                border: 1px solid #ced4da;
                border-radius: 12px;
                background-color: #ffffff;
                overflow: hidden;
                display: flex;
                align-items: center;
                transition: all 0.2s ease;
            }

                .input-group-custom:focus-within {
                    border-color: #1e4b9e;
                    box-shadow: 0 0 0 3px rgba(30, 75, 158, 0.15);
                }

            .input-icon {
                padding: 0.75rem 1rem;
                color: #555555;
                font-size: 1.1rem;
            }

            .form-input {
                border: none;
                outline: none;
                width: 100%;
                padding: 0.75rem 1rem 0.75rem 0;
                font-size: 0.95rem;
                background: transparent;
            }

            /* Botón de ingreso color azul Intecap */
            .btn-login {
                background-color: #2b529a;
                color: #ffffff;
                font-weight: 700;
                font-size: 1.05rem;
                padding: 0.85rem;
                border-radius: 25px;
                border: none;
                width: 100%;
                letter-spacing: 0.5px;
                transition: background-color 0.2s ease;
            }

                .btn-login:hover {
                    background-color: #1d3b73;
                    color: #ffffff;
                }

            .login-links a {
                color: #2b529a;
                text-decoration: underline;
                font-weight: 600;
                font-size: 0.95rem;
            }

                .login-links a:hover {
                    color: #162f5c;
                }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- LOGO DE INTECAP (Verifica que la imagen exista en wwwroot/images/logo_intecap.png) -->
        <img src="~/images/logo_intecap.png" alt="Intecap" class="login-logo" onerror="this.onerror=null; this.src='https://upload.wikimedia.org/wikipedia/commons/thumb/7/70/Logo_INTECAP.svg/1200px-Logo_INTECAP.svg.png';" />

        <h2 class="login-title">Iniciar Sesión</h2>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small fw-bold mb-3">
                    @Html.ValidationSummary(true, "")
                </div>
            }

            <!-- CAMPO USUARIO / CORREO -->
            <div class="mb-3 text-start">
                <div class="input-group-custom">
                    <span class="input-icon"><i class="bi bi-person-fill"></i></span>
                    <input asp-for="Email" class="form-input" placeholder="Nombre de Usuario o Correo" autocomplete="off" />
                </div>
                <span asp-validation-for="Email" class="text-danger small ms-1"></span>
            </div>

            <!-- CAMPO CONTRASEÑA -->
            <div class="mb-4 text-start">
                <div class="input-group-custom">
                    <span class="input-icon"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="Password" class="form-input" placeholder="Contraseña" />
                </div>
                <span asp-validation-for="Password" class="text-danger small ms-1"></span>
            </div>

            <!-- BOTÓN DE ACCESO -->
            <button type="submit" class="btn btn-login mb-4">ACCEDER / LOG IN</button>

            <!-- ENLACES SECUNDARIOS -->
            <div class="login-links d-flex flex-column gap-2">
                <a href="#" onclick="alert('Contacta al Administrador del sistema.'); return false;">Restablecer Contraseña</a>
                <a href="#" onclick="alert('El registro de personal debe ser realizado por el Administrador.'); return false;">Registrarse (para personal)</a>
            </div>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>

