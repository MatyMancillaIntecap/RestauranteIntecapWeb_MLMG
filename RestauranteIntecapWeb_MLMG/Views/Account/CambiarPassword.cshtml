@model CambiarContrasenaDTO
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h1 class="fw-bold text-primary mb-2">🔐 Cambiar Contraseña</h1>
                        <p class="text-muted">Actualiza tu contraseña de acceso al sistema</p>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>⚠️ Error:</strong> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Exito"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>✅ Éxito:</strong> @TempData["Exito"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                        <div class="text-center mt-4">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="text-muted fw-bold">Redirigiendo a tu panel en segundos...</p>
                        </div>
                    }

                    @if (!TempData.ContainsKey("Exito"))
                    {
                        <form method="post" asp-action="CambiarPassword" class="needs-validation" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="ContrasenaActual" class="form-label fw-bold">
                                    🔑 Contraseña Actual
                                </label>
                                <input type="password" 
                                       class="form-control form-control-lg" 
                                       id="ContrasenaActual"
                                       asp-for="ContrasenaActual"
                                       placeholder="Ingresa tu contraseña actual"
                                       required>
                                <span asp-validation-for="ContrasenaActual" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label for="NuevaContrasena" class="form-label fw-bold">
                                    ✨ Nueva Contraseña
                                </label>
                                <input type="password" 
                                       class="form-control form-control-lg" 
                                       id="NuevaContrasena"
                                       asp-for="NuevaContrasena"
                                       placeholder="Mínimo 8 caracteres"
                                       required>
                                <small class="text-muted d-block mt-1">
                                    Debe tener al menos 8 caracteres
                                </small>
                                <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label for="ConfirmarContrasena" class="form-label fw-bold">
                                    ✓ Confirmar Nueva Contraseña
                                </label>
                                <input type="password" 
                                       class="form-control form-control-lg" 
                                       id="ConfirmarContrasena"
                                       asp-for="ConfirmarContrasena"
                                       placeholder="Repite tu nueva contraseña"
                                       required>
                                <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg fw-bold">
                                    💾 Guardar Nueva Contraseña
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg fw-bold">
                                    ← Cancelar
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>

            <div class="mt-4 p-3 bg-light rounded-3 border border-warning">
                <h6 class="fw-bold text-warning mb-2">💡 Recomendaciones de seguridad:</h6>
                <ul class="small text-muted mb-0">
                    <li>Usa una contraseña única y segura</li>
                    <li>Incluye letras, números y caracteres especiales</li>
                    <li>No compartas tu contraseña con nadie</li>
                    <li>Cámbiala regularmente por seguridad</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
