@model IEnumerable<RestauranteIntecapWeb_MLMG.Models.DTOs.HistorialEmpleadoDTO>

@{
    ViewData["Title"] = "Mi Historial de Reservas";
    string fInicio = ViewBag.FechaInicio ?? "";
    string fFin = ViewBag.FechaFin ?? "";
    string estSel = ViewBag.EstadoSel ?? "Todos";
}

<div class="container mt-3 mb-5">
    <!-- BARRA SUPERIOR UNIFICADA CON BOTÓN DE REGRESO, DESCARGAS Y FILTROS -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body bg-light p-3">
            <div class="row align-items-center mb-3">
                <div class="col-md-6 col-12 mb-2 mb-md-0">
                    <a asp-controller="Empleado" asp-action="Index" class="btn btn-outline-primary fw-bold text-nowrap mb-2">
                        ⬅️ Regresar al Menú Principal
                    </a>
                    <h3 class="text-primary fw-bold mb-1">📜 Mi Historial de Reservas</h3>
                    <p class="text-muted mb-0 small">Consulta tus solicitudes realizadas, cancela pedidos activos o descarga tus reportes.</p>
                </div>
                <div class="col-md-6 col-12 text-md-end">
                    <a asp-action="DescargarHistorialExcel" asp-route-fechaInicio="@fInicio" asp-route-fechaFin="@fFin" asp-route-estado="@estSel" class="btn btn-success fw-bold me-1">
                        📊 Excel
                    </a>
                    <a asp-action="DescargarHistorialPdf" asp-route-fechaInicio="@fInicio" asp-route-fechaFin="@fFin" asp-route-estado="@estSel" target="_blank" class="btn btn-danger fw-bold">
                        📄 PDF
                    </a>
                </div>
            </div>

            <!-- FORMULARIO DE FILTROS (RANGO DE FECHAS Y ESTADO) -->
            <form method="get" asp-controller="Empleado" asp-action="Historial" class="row g-2 align-items-end border-top pt-3">
                <div class="col-md-3 col-6">
                    <label class="form-label small fw-bold">Fecha Inicio:</label>
                    <input type="date" name="fechaInicio" class="form-control form-control-sm" value="@fInicio" />
                </div>
                <div class="col-md-3 col-6">
                    <label class="form-label small fw-bold">Fecha Fin:</label>
                    <input type="date" name="fechaFin" class="form-control form-control-sm" value="@fFin" />
                </div>
                <div class="col-md-3 col-6">
                    <label class="form-label small fw-bold">Estado:</label>
                    <select name="estado" class="form-select form-select-sm">
                        <option value="Todos" selected="@(estSel == "Todos")">Todos los estados</option>
                        <option value="Activa" selected="@(estSel == "Activa")">Activa</option>
                        <option value="Cancelada" selected="@(estSel == "Cancelada")">Cancelada</option>
                        <option value="Entregada" selected="@(estSel == "Entregada")">Entregada</option>
                    </select>
                </div>
                <div class="col-md-3 col-6 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm fw-bold w-100">🔍 Filtrar</button>
                    <a asp-action="Historial" class="btn btn-outline-secondary btn-sm text-nowrap">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- TABLA DE DETALLE DE HISTORIAL -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th># Reserva</th>
                            <th>Fecha Consumo</th>
                            <th>Platillo</th>
                            <th>Cantidad</th>
                            <th>Total Pagado</th>
                            <th>Forma Pago</th>
                            <th>NIT</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>#@item.ReservaId</strong></td>
                                    <td>@item.FechaConsumo.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <div class="fw-bold">@item.NombrePlato</div>
                                        <small class="text-muted">@item.DondeConsume</small>
                                    </td>
                                    <td><span class="badge bg-primary fs-6">@item.Cantidad</span></td>
                                    <td><strong class="text-success">Q @item.TotalPagado.ToString("F2")</strong></td>
                                    <td><span class="badge bg-info text-dark">@item.FormaPago</span></td>
                                    <td><span class="badge bg-light text-dark border">@item.NitFacturacion</span></td>
                                    <td>
                                        @if (item.Estado == "Activa")
                                        {
                                            <span class="badge bg-success">Activa</span>
                                        }
                                        else if (item.Estado == "Cancelada")
                                        {
                                            <span class="badge bg-danger">Cancelada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Estado</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Estado == "Activa" && item.FechaConsumo.Date >= DateTime.Today)
                                        {
                                            <button class="btn btn-sm btn-outline-danger fw-bold" onclick="cancelarReserva(@item.ReservaId)">
                                                🚫 Cancelar
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">No se encontraron reservas registradas para el filtro seleccionado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cancelarReserva(reservaId) {
            if (confirm("¿Estás seguro de cancelar este platillo de tu reserva? El stock será devuelto al menú del día.")) {
                $.post('/Empleado/CancelarReserva', { reservaId: reservaId })
                    .done(function(res) {
                        alert(res.mensaje);
                        location.reload();
                    })
                    .fail(function(xhr) {
                        alert(xhr.responseText || "No fue posible cancelar la reserva.");
                    });
            }
        }
    </script>
}