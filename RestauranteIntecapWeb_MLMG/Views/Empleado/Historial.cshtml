@model List<RestauranteIntecapWeb_MLMG.Models.DTOs.HistorialEmpleadoDTO>

@{
    ViewData["Title"] = "Mi Historial de Reservas";
}

<div class="container-fluid mt-4 mb-5">

    <!-- CABECERA Y BOTONES DE EXPORTACIÓN -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          
            <h3 class="text-primary fw-bold mb-0">📜 Mi Historial de Reservas</h3>
            <p class="text-muted small mb-0">Consulta tus solicitudes de almuerzos realizadas y descarga tus reportes.</p>
        </div>

        <!-- BOTONES PARA DESCARGAR EXCEL Y PDF -->
        <div class="d-flex gap-2">
            <a asp-action="DescargarExcelHistorial"
               asp-route-fechaInicio="@ViewBag.FechaInicio"
               asp-route-fechaFin="@ViewBag.FechaFin"
               class="btn btn-success fw-bold d-flex align-items-center gap-1">
                <i class="bi bi-file-earmark-excel"></i> Excel
            </a>
            <a asp-action="DescargarPdfHistorial"
               asp-route-fechaInicio="@ViewBag.FechaInicio"
               asp-route-fechaFin="@ViewBag.FechaFin"
               class="btn btn-danger fw-bold d-flex align-items-center gap-1"
               target="_blank">
                <i class="bi bi-file-earmark-pdf"></i> PDF
            </a>
        </div>
    </div>

    <!-- FORMULARIO DE FILTROS ÚNICAMENTE POR RANGO DE FECHAS -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body bg-light p-3">
            <form method="get" asp-controller="Empleado" asp-action="Historial" class="row g-3 align-items-end">

                <div class="col-md-4 col-6">
                    <label class="form-label small fw-bold text-secondary">Fecha Inicio:</label>
                    <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
                </div>

                <div class="col-md-4 col-6">
                    <label class="form-label small fw-bold text-secondary">Fecha Fin:</label>
                    <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
                </div>

                <div class="col-md-4 col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary fw-bold w-100">
                        🔍 Filtrar
                    </button>
                    <a asp-action="Historial" class="btn btn-outline-secondary fw-bold">
                        Limpiar
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- TABLA INFORMATIVA DE HISTORIAL (SIN ESTADO NI ACCIONES) -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3"># Reserva</th>
                            <th>Fecha Consumo</th>
                            <th>Platillo</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Total Pagado</th>
                            <th class="text-center">Forma Pago</th>
                            <th class="text-center pe-3">NIT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- NÚMERO DE RESERVA -->
                                    <td class="ps-3 fw-bold text-primary">#@item.ReservaId</td>

                                    <!-- FECHA -->
                                    <td>
                                        <div class="fw-bold">@item.FechaConsumo.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">Solicitado: @item.FechaReserva.ToString("HH:mm") hrs</small>
                                    </td>

                                    <!-- PLATILLO -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                            {
                                                <img src="@item.ImagenUrl" alt="@item.NombrePlato" style="width: 40px; height: 40px; object-fit: cover;" class="rounded" onerror="this.style.display='none'" />
                                            }
                                            <div>
                                                <div class="fw-bold">@item.NombrePlato</div>
                                                <small class="text-muted">Consumo: @item.DondeConsume</small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- CANTIDAD -->
                                    <td class="text-center">
                                        <span class="badge bg-primary fs-6 px-3">@item.Cantidad</span>
                                    </td>

                                    <!-- TOTAL PAGADO -->
                                    <td class="text-end fw-bold text-success">
                                        Q @((item.Cantidad * item.PrecioUnitario).ToString("F2"))
                                    </td>

                                    <!-- FORMA DE PAGO -->
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark">@item.FormaPago</span>
                                    </td>

                                    <!-- NIT -->
                                    <td class="text-center pe-3">
                                        <span class="badge bg-light text-dark border">@item.NitFacturacion</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="fs-4 mb-2">🍽️</div>
                                    No se encontraron reservas registradas para el rango de fechas seleccionado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>