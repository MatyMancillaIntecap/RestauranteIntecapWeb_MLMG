@model IEnumerable<RestauranteIntecapWeb_MLMG.Models.MenuDiario>

@{
    ViewData["Title"] = "Menú del Día - Reservas";
    int usuarioId = ViewBag.UsuarioId ?? 3;
    int limiteMaximo = ViewBag.LimiteMaximo ?? 2; // <--- Capturamos el límite enviado desde el backend
}



<div class="container mt-3 mb-5">
    <div class="row align-items-center mb-4">
        <div class="col-md-8 col-12">
            <h3 class="text-primary fw-bold">🍽️ Menú del Día (@DateTime.Today.ToString("dd/MM/yyyy"))</h3>
            <p class="text-muted mb-0">Selecciona hasta un máximo de 2 almuerzos por día e indica la forma de pago para cada uno.</p>
        </div>
    </div>

    <div class="row">
        <!-- LISTA DE PLATILLOS -->
        <div class="col-lg-8 col-12 mb-4">
            <div class="row">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-md-6 col-12 mb-4">
                            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                                @if (!string.IsNullOrEmpty(item.imagen_url))
                                {
                                    <img src="@item.imagen_url" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@item.nombre_plato" />
                                }
                                else
                                {
                                    <div class="bg-secondary text-white text-center py-5">Sin Imagen</div>
                                }

                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="card-title fw-bold mb-0">@item.nombre_plato</h5>
                                        @if (item.es_dieta)
                                        {
                                            <span class="badge bg-info text-dark">🌿 Dieta</span>
                                        }
                                        <span class="badge bg-success">Disponible</span>
                                    </div>

                                    <p class="card-text text-muted small">@item.descripcion</p>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="fs-5 fw-bold text-primary">Q @item.precio.ToString("F2")</span>
                                        <span class="badge bg-light text-dark border">Stock: @item.stock</span>
                                    </div>

                                    <div class="border-top pt-3">
                                        <!-- Selector de Cantidad con validación de Stock máximo -->
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Cantidad:</label>
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary" type="button" onclick="cambiarCantidad(@item.id, -1)">-</button>


                                                <input type="number" id="cantidad_@item.id" class="form-control text-center fw-bold" value="1" min="1" max="@item.stock" readonly />



                                                <button class="btn btn-outline-secondary" type="button" onclick="cambiarCantidad(@item.id, 1, @item.stock)">+</button>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Forma de Pago para este platillo:</label>
                                            <select id="pago_@item.id" class="form-select form-select-sm">
                                                <option value="1">💵 Efectivo</option>
                                                <option value="2">💳 Carnet</option>
                                            </select>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold">Consumo:</label>
                                            <select id="lugar_@item.id" class="form-select form-select-sm">
                                                <option value="En restaurante">🍽️ En restaurante</option>
                                                <option value="Llevar">🛍️ Llevar</option>
                                            </select>
                                        </div>
                                        <button class="btn btn-primary w-100 fw-bold mt-2" onclick="agregarAlCarrito(@item.id, '@item.nombre_plato', @item.precio, @item.stock)">
                                            🛒 Seleccionar Platillo
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-warning text-center py-4">
                            No hay platillos disponibles para reservar en este momento.
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- PANEL LATERAL: CARRITO DE COMPRA -->
        <div class="col-lg-4 col-12">
            <div class="card shadow-sm border-0 rounded-3 sticky-top" style="top: 20px;">
               
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">🛍️ Mi Solicitud (<span id="countPlatillos">0</span>/@limiteMaximo)</h5>
                </div>



                <div class="card-body">
                    <div id="listaCarrito" class="mb-3">
                        <p class="text-muted text-center py-3">No has seleccionado platillos aún.</p>
                    </div>

                    <!-- CAMPO DE NIT PARA FACTURACIÓN -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold">NIT para Facturación (Opcional):</label>
                        <input type="text" id="nitInput" class="form-control form-control-sm" value="@ViewBag.NitUsuario" placeholder="C/F o 1-13 dígitos" />
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold fs-5">Total a Pagar:</span>
                        <span id="totalPagar" class="fw-bold fs-5 text-success">Q 0.00</span>
                    </div>
                    <button id="btnConfirmar" class="btn btn-success w-100 fw-bold fs-6" onclick="confirmarReserva()" disabled>
                        ✅ Confirmar Reserva
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL AMIGABLE DE LÍMITE ALCANZADO -->
<div class="modal fade" id="modalLimiteAlcanzado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-3">
            <div class="modal-body">
                <div class="fs-1 text-warning mb-2">⚠️</div>
                <h4 class="fw-bold text-dark mb-2">Límite de Reservas Alcanzado</h4>
                <p id="mensajeLimite" class="text-muted mb-4">Has alcanzado el límite máximo permitido de 2 almuerzos por día para tu cuenta.</p>
                <button type="button" class="btn btn-primary fw-bold px-4" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let carrito = [];
        const usuarioId = @usuarioId;
        const limiteMaximoPermitido = @limiteMaximo; // Límite dinámico inyectado desde C# (10 para Admin, 2 para Empleado)

        function cambiarCantidad(idPlatillo, cambio, stockMaximo) {
            const input = document.getElementById('cantidad_' + idPlatillo);
                 if (!input) return;

                let valorActual = parseInt(input.value) || 1;
                let nuevoValor = valorActual + cambio;

                // Validación inferior: la cantidad mínima siempre es 1
                if (nuevoValor < 1) {
                    nuevoValor = 1;
                }

                // Determinamos el límite superior estricto:
                // El valor no puede ser mayor al stock del platillo NI mayor al límite máximo permitido por el rol.
                let limiteSuperior = stockMaximo ? Math.min(stockMaximo, limiteMaximoPermitido) : limiteMaximoPermitido;

                if (nuevoValor > limiteSuperior) {
                    nuevoValor = limiteSuperior;
        
                    // Opcional pero profesional: Notificar sutilmente por qué no sube más
                    console.ern?.("Se alcanzó el límite máximo permitido.");
                }

    input.value = nuevoValor;
        }

        function agregarAlCarrito(id, nombre, precio, stockMaximo) {
            const inputCantidad = document.getElementById('cantidad_' + id);
            const cantidadSeleccionada = parseInt(inputCantidad.value) || 1;

            const selectPago = document.getElementById('pago_' + id);
            const pagoId = selectPago ? parseInt(selectPago.value) : 1;
            const pagoTexto = selectPago ? selectPago.options[selectPago.selectedIndex].text : "Efectivo";

            const selectLugar = document.getElementById('lugar_' + id);
            const lugarConsumo = selectLugar ? selectLugar.value : "En restaurante";

            if (cantidadSeleccionada > stockMaximo) {
                alert("No puedes pedir más de " + stockMaximo + " unidades disponibles.");
                return;
            }

            if (cantidadSeleccionada < 1) {
                alert("Debe seleccionar al menos 1 unidad.");
                return;
            }

            // Validación única y limpia del límite máximo permitido por rol
            let totalUnidadesActuales = carrito.reduce((sum, item) => sum + item.cantidad, 0);
            if ((totalUnidadesActuales + cantidadSeleccionada) > limiteMaximoPermitido) {
                $('#mensajeLimite').text("No puedes agregar esta cantidad. El sistema permite un máximo de " + limiteMaximoPermitido + " almuerzos por día para tu cuenta y ya tienes " + totalUnidadesActuales + " seleccionados.");
                var modal = new bootstrap.Modal(document.getElementById('modalLimiteAlcanzado'));
                modal.show();
                return;
            }

            let existente = carrito.find(item => item.menuId === id && item.formaPagoId === pagoId && item.dondeConsume === lugarConsumo);

            if (existente) {
                if ((existente.cantidad + cantidadSeleccionada) > stockMaximo) {
                    alert("La cantidad total en el carrito supera el stock disponible.");
                    return;
                }
                existente.cantidad += cantidadSeleccionada;
            } else {
                carrito.push({
                    menuId: id,
                    nombre: nombre,
                    precio: precio,
                    cantidad: cantidadSeleccionada,
                    formaPagoId: pagoId,
                    formaPagoTexto: pagoTexto,
                    dondeConsume: lugarConsumo
                });
            }

            renderizarCarrito();
        }

        function renderizarCarrito() {
            let contenedor = $('#listaCarrito');
            contenedor.empty();

            if (carrito.length === 0) {
                contenedor.html('<p class="text-muted text-center py-3">No has seleccionado platillos aún.</p>');
                $('#totalPagar').text('Q 0.00');
                $('#countPlatillos').text('0');
                $('#btnConfirmar').prop('disabled', true);
                return;
            }

            let total = 0;
            let cantidadTotal = 0;

            carrito.forEach((item, index) => {
                let subtotal = item.precio * item.cantidad;
                total += subtotal;
                cantidadTotal += item.cantidad;

                let html = `
                            <div class="p-2 mb-2 bg-light rounded border">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-primary">${item.nombre}</strong>
                                    <button class="btn btn-sm btn-outline-danger" onclick="eliminarDelCarrito(${index})">❌</button>
                                </div>
                                <div class="small text-muted">
                                    Cant: ${item.cantidad} | Q ${item.precio.toFixed(2)} c/u<br>
                                    Pago: <span class="badge bg-info text-dark">${item.formaPagoTexto}</span> (${item.dondeConsume})
                                </div>
                            </div>
                        `;
                contenedor.append(html);
            });

            $('#totalPagar').text('Q ' + total.toFixed(2));
            $('#countPlatillos').text(cantidadTotal);
            $('#btnConfirmar').prop('disabled', false);
        }

        function eliminarDelCarrito(index) {
            carrito.splice(index, 1);
            renderizarCarrito();
        }

        function confirmarReserva() {
            if (carrito.length === 0) return;

            let nitVal = $('#nitInput').val().trim();
            if (nitVal === "") {
                nitVal = "C/F";
            }

            let regexNit = /^(C\/F|c\/f|\d{1,13})$/;
            if (!regexNit.test(nitVal)) {
                $('#mensajeLimite').html("<strong>Formato de NIT Incorrecto</strong><br>El NIT debe contener entre 1 y 13 dígitos numéricos (sin guiones) o indicar 'C/F'.");
                var modal = new bootstrap.Modal(document.getElementById('modalLimiteAlcanzado'));
                modal.show();
                return;
            }

            let payload = {
                usuarioId: usuarioId,
                nitFacturacion: nitVal,
                platillos: carrito.map(item => ({
                    menuId: item.menuId,
                    cantidad: item.cantidad,
                    formaPagoId: item.formaPagoId,
                    dondeConsume: item.dondeConsume
                }))
            };

            $.ajax({
                url: '/Empleado/RealizarReserva',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    alert(res.mensaje);
                    window.location.href = '/Empleado/Historial';
                },
                error: function(xhr) {
                    $('#mensajeLimite').text(xhr.responseText || "No fue posible procesar la reserva.");
                    var modal = new bootstrap.Modal(document.getElementById('modalLimiteAlcanzado'));
                    modal.show();
                }
            });
        }
    </script>
}