@model IEnumerable<RestauranteIntecapWeb_MLMG.Models.MenuDiario>
@using RestauranteIntecapWeb_MLMG.Models.DTOs

@{
    ViewData["Title"] = "Gestión de Menú y Reportes - Cocina";
    DateTime fechaSel = ViewBag.FechaConsulta ?? DateTime.Today;
    var consolidado = ViewData["Consolidado"] as List<PlatilloConsolidadoDTO> ?? new List<PlatilloConsolidadoDTO>();
    var reservasDetalle = ViewData["ReservasDetalle"] as List<ReservaDetalleDTO> ?? new List<ReservaDetalleDTO>();
}

<div class="container-fluid mt-3 mb-5">
    <!-- BARRA SUPERIOR Y FILTRO DE FECHA CON EXPORTACIONES -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body bg-light rounded-3 p-3">
            <div class="row align-items-center">
                <div class="col-md-5 col-12">



                    <h3 class="text-primary fw-bold mb-1">👨‍🍳 Área de Cocina </h3>
                    <p class="text-muted mb-0">Gestión de platillos, consolidado de pedidos y descarga de reportes.</p>





                </div>
                <div class="col-md-7 col-12 mt-3 mt-md-0">
                    <form method="get" asp-controller="Cocina" asp-action="Index" class="d-flex align-items-center justify-md-content-end gap-2 flex-wrap">
                        <label class="fw-bold text-nowrap">Fecha Consulta:</label>
                        <input type="date" name="fecha" class="form-control w-auto" value="@fechaSel.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                        <a asp-action="DescargarExcel" asp-route-fecha="@fechaSel.ToString("yyyy-MM-dd")" class="btn btn-success fw-bold text-nowrap">
                            📊 Excel
                        </a>
                        <a asp-action="DescargarPdf" asp-route-fecha="@fechaSel.ToString("yyyy-MM-dd")" target="_blank" class="btn btn-danger fw-bold text-nowrap">
                            📄 PDF
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS DE NAVEGACIÓN -->
    <ul class="nav nav-tabs nav-justified mb-4 fw-bold" id="cocinaTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="menu-tab" data-bs-toggle="tab" data-bs-target="#tab-menu" type="button" role="tab">
                📋 Gestión de Menú
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="consolidado-tab" data-bs-toggle="tab" data-bs-target="#tab-consolidado" type="button" role="tab">
                📊 Recuento Consolidado (@consolidado.Sum(c => c.TotalSolicitado))
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="reservas-tab" data-bs-toggle="tab" data-bs-target="#tab-reservas" type="button" role="tab">
                👥 Detalle de Reservas (@reservasDetalle.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="cocinaTabsContent">
        <!-- PESTAÑA 1: GESTIÓN DE MENÚ -->
        <div class="tab-pane fade show active" id="tab-menu" role="tabpanel">
            <div class="row">
                <!-- Formulario de Registro Lateral unificado y limpio -->
                <div class="col-lg-4 col-12 mb-4">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-primary text-white font-weight-bold">
                            <h5 class="mb-0">➕ Publicar Opción del Día</h5>
                        </div>
                        <div class="card-body">
                            <form asp-controller="Cocina" asp-action="GuardarMenu" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="0" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Nombre del Platillo</label>
                                    <input type="text" name="nombre_plato" class="form-control" placeholder="Ej. Pollo en crema" required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Descripción</label>
                                    <textarea name="descripcion" class="form-control" rows="2" placeholder="Detalles del platillo..."></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-6 mb-3">
                                        <label class="form-label fw-bold">Precio (Q)</label>
                                        <input type="number" step="0.01" name="precio" class="form-control" placeholder="20.00" required />
                                    </div>
                                    <div class="col-6 mb-3">
                                        <label class="form-label fw-bold">Stock Inicial</label>
                                        <input type="number" name="stock" class="form-control" placeholder="150" required />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-6">
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" name="es_dieta" value="true" id="chkDieta">
                                            <label class="form-check-label" for="chkDieta">Es Dieta</label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label fw-bold small">Fecha Menú</label>
                                        <input type="date" name="fecha" class="form-control" value="@fechaSel.ToString("yyyy-MM-dd")" required />
                                    </div>
                                </div>

                                <!-- CAMPO UNIFICADO DE HABILITACIÓN PROGRAMADA (Sin duplicidades) -->
                                <div class="mb-3">
                                    <label for="hora_habilitacion" class="form-label fw-bold">Programar Publicación (Fecha y Hora)</label>
                                    <input type="datetime-local" class="form-control" id="hora_habilitacion" name="hora_habilitacion" required />
                                    <div class="form-text text-muted small">Los empleados verán este platillo a partir de la fecha y hora seleccionada.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Fotografía</label>
                                    <input type="file" name="imagenFile" class="form-control" accept="image/*" />
                                </div>

                                <button type="submit" class="btn btn-success w-100 fw-bold">💾 Publicar Menú</button>
                            </form>
                        </div>
                    </div>
                </div>





                <!-- Tabla de Platillos Registrados -->
                <div class="col-lg-8 col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0">📋 Platillos Registrados</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Imagen</th>
                                            <th>Platillo</th>
                                            <th>Precio</th>
                                            <th>Stock (Disp. / Inicial)</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            @foreach (var plato in Model)
                                            {
                                                <tr>
                                                    <td class="ps-3">
                                                        <img src="@plato.imagen_url" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="Platillo" />
                                                    </td>
                                                    <td>
                                                        <span class="fw-bold text-dark">@plato.nombre_plato</span>
                                                        @if (plato.es_dieta)
                                                        {
                                                            <br><span class="badge bg-info text-dark" style="font-size: 0.7rem;">🌿 Dieta</span>
                                                        }
                                                        <br>
                                                        @if (plato.estado == "Disponible")
                                                        {
                                                            <span class="badge bg-success" style="font-size: 0.7rem;">✅ Habilitado</span>
                                                        }
                                                        else if (plato.estado == "Inactivo")
                                                        {
                                                            <span class="badge bg-secondary" style="font-size: 0.7rem;">🚫 Deshabilitado</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark" style="font-size: 0.7rem;">@plato.estado</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="text-success fw-bold">Q @plato.precio.ToString("F2")</span>
                                                    </td>



                                                    <td>
                                                        <!-- Métrica visual clara: Stock Actual Disponible / Stock Inicial Total (Disponible + Vendido) -->
                                                        <span class="badge bg-primary px-2 py-1">
                                                            @plato.stock / @(plato.stock + plato.cantidad_solicitada)
                                                        </span>
                                                    </td>




                                                    <td >
                                                        <button class="btn btn-sm btn-outline-primary me-1" onclick="abrirModalEditar(@plato.id)" title="Editar">
                                                            ✏️
                                                        </button>
                                                        @if (plato.estado == "Disponible")
                                                        {
                                                            <button class="btn btn-sm btn-outline-warning me-1" onclick="cambiarEstadoPlatillo(@plato.id, 'Inactivo')" title="Deshabilitar platillo">
                                                                🚫
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-success me-1" onclick="cambiarEstadoPlatillo(@plato.id, 'Disponible')" title="Habilitar platillo">
                                                                ✅
                                                            </button>
                                                        }
                                                        <button class="btn btn-sm btn-outline-danger" onclick="eliminarMenu(@plato.id)" title="Eliminar">
                                                            🗑️
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">No hay platillos registrados para esta fecha.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PESTAÑA 2: RECUENTO CONSOLIDADO -->
        <div class="tab-pane fade" id="tab-consolidado" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📊 Consolidados por Platillo Solicitado</h5>
                </div>
                <div class="card-body">
                    @if (consolidado.Any())
                    {
                        <div class="row">
                            @foreach (var item in consolidado)
                            {
                                <div class="col-md-4 col-12 mb-3">
                                    <div class="card @(item.EstadoPlatillo == "Inactivo" ? "border-warning" : "border-primary") h-100 shadow-sm">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <h5 class="card-title fw-bold @(item.EstadoPlatillo == "Inactivo" ? "text-warning" : "text-primary")">@item.NombrePlato</h5>
                                                @if (item.EstadoPlatillo == "Inactivo")
                                                {
                                                    <span class="badge bg-warning text-dark">⚠️ Deshabilitado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">✅ Activo</span>
                                                }
                                            </div>
                                            <p class="text-muted mb-1">Precio Unitario: Q @item.Precio.ToString("F2")</p>
                                            @if (item.EstadoPlatillo == "Inactivo")
                                            {
                                                <div class="alert alert-warning py-1 px-2 mb-2 small">
                                                    <strong>Nota:</strong> Este platillo fue deshabilitado. Las reservas se mantienen registradas.
                                                </div>
                                            }
                                            <hr />
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fs-6 text-secondary">Solicitudes:</span>
                                                <span class="badge bg-success fs-5">@item.TotalSolicitado unidades</span>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mt-2">
                                                <span class="fs-6 text-secondary">Total Acumulado:</span>
                                                <span class="fw-bold text-dark fs-5">Q @item.TotalRecaudado.ToString("F2")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center py-4 mb-0">
                            No se registran solicitudes activas para la fecha seleccionada.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- PESTAÑA 3: DETALLE DE RESERVAS -->
        <div class="tab-pane fade" id="tab-reservas" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">👥 Detalle de Personas que Reservaron</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Empleado</th>
                                    <th>Plato Elegido</th>
                                    <th>Cantidad</th>
                                    <th>¿Dónde Consume?</th>
                                    <th>Forma de Pago</th>
                                    <th>Hora Reserva</th>
                                    <th>Estado Platillo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (reservasDetalle.Any())
                                {
                                    int correlativo = 1;
                                    @foreach (var res in reservasDetalle)
                                    {
                                        <tr>
                                            <td>@(correlativo++)</td>
                                            <td>
                                                <div class="fw-bold">@res.NombreEmpleado</div>
                                                <small class="text-muted">@res.EmailEmpleado</small>
                                            </td>
                                            <td><span class="badge bg-secondary fs-6">@res.NombrePlato</span></td>
                                            <td><span class="badge bg-primary fs-6">@res.Cantidad</span></td>
                                            <td><span class="badge bg-info text-dark">@res.DondeConsume</span></td>
                                            <td><span class="badge bg-success">@res.FormaPago</span></td>
                                            <td>@res.FechaReserva.ToString("HH:mm:ss")</td>
                                            <td>
                                                @if (res.EstadoPlatillo == "Disponible")
                                                {
                                                    <span class="badge bg-success">✅ Disponible</span>
                                                }
                                                else if (res.EstadoPlatillo == "Inactivo")
                                                {
                                                    <span class="badge bg-warning text-dark">⚠️ Deshabilitado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@res.EstadoPlatillo</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">Sin registros de reservas para esta fecha.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE EDICIÓN BOOTSTRAP -->
<div class="modal fade" id="modalEditarMenu" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">✏️ Editar Platillo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Cocina" asp-action="GuardarMenu" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="edit_id" name="id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Platillo</label>
                        <input type="text" id="edit_nombre_plato" name="nombre_plato" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción</label>
                        <textarea id="edit_descripcion" name="descripcion" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Precio (Q)</label>
                            <input type="number" step="0.01" id="edit_precio" name="precio" class="form-control" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Stock</label>
                            <input type="number" id="edit_stock" name="stock" class="form-control" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="edit_es_dieta" name="es_dieta" value="true">
                                <label class="form-check-label" for="edit_es_dieta">Es Dieta</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <input type="date" id="edit_fecha" name="fecha" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Cambiar Fotografía (Opcional)</label>
                        <input type="file" name="imagenFile" class="form-control" accept="image/*" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold">💾 Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalEditar(id) {
            $.get('/Cocina/ObtenerMenuPorId/' + id)
                .done(function(data) {
                    $('#edit_id').val(data.id);
                    $('#edit_nombre_plato').val(data.nombre_plato);
                    $('#edit_descripcion').val(data.descripcion);
                    $('#edit_precio').val(data.precio);
                    $('#edit_stock').val(data.stock);
                    $('#edit_es_dieta').prop('checked', data.es_dieta);
                   
                    if (data.fecha) {
                        $('#edit_fecha').val(data.fecha.split('T')[0]);
                    }

                    var modal = new bootstrap.Modal(document.getElementById('modalEditarMenu'));
                    modal.show();
                })
                .fail(function() {
                    alert('Error al obtener los datos del platillo.');
                });
        }

        function eliminarMenu(id) {
            if (confirm("¿Está seguro de eliminar este platillo?")) {
                $.post('/Cocina/EliminarMenu', { id: id })
                    .done(function(mensaje) {
                        alert(mensaje);
                        location.reload();
                    })
                    .fail(function(xhr) {
                        alert(xhr.responseText || "No se pudo eliminar el platillo.");
                    });
            }
        }

        function cambiarEstadoPlatillo(id, nuevoEstado) {
            var accion = nuevoEstado === "Disponible" ? "habilitar" : "deshabilitar";
            var mensaje = nuevoEstado === "Inactivo" 
                ? "¿Está seguro de deshabilitar este platillo?\n\nEsto evitará que los empleados puedan hacer nuevas reservas, pero las reservas existentes se mantendrán intactas."
                : "¿Desea habilitar este platillo para permitir nuevas reservas?";

            if (confirm(mensaje)) {
                $.post('/Cocina/CambiarEstado', { id: id, nuevoEstado: nuevoEstado })
                    .done(function() {
                        alert("El platillo ha sido " + (nuevoEstado === "Disponible" ? "habilitado" : "deshabilitado") + " exitosamente.");
                        location.reload();
                    })
                    .fail(function() {
                        alert("Error al cambiar el estado del platillo.");
                    });
            }
        }
    </script>
}