@model RestauranteIntecapWeb_MLMG.Models.DTOs.DetalleUsuarioCompletoDTO

@{
    ViewData["Title"] = "Ficha Detallada de Usuario - Administrador";
}

<div class="container mt-3 mb-5">
    <!-- BARRA SUPERIOR CON REGRESO -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body bg-light p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <a asp-action="Usuarios" class="btn btn-outline-primary btn-sm fw-bold mb-2">
                        ⬅️ Regresar a la Lista de Usuarios
                    </a>
                    <h3 class="text-primary fw-bold mb-0">👤 Ficha de Usuario: @Model.InfoUsuario.Nombre</h3>
                </div>
                <div>
                    @if (Model.InfoUsuario.Activo)
                    {
                        <span class="badge bg-success fs-6">Cuenta Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">Cuenta Inactiva</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- TARJETAS DE INFORMACIÓN PERSONAL Y CONSUMO -->
    <div class="row mb-4">
        <!-- Ficha de Datos Personales -->
        <div class="col-md-6 col-12 mb-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">📋 Información de Perfil</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>ID Usuario:</strong> #@Model.InfoUsuario.Id</p>
                    <p class="mb-2"><strong>Correo Electrónico:</strong> @Model.InfoUsuario.Email</p>
                    <p class="mb-2"><strong>Rol Asignado:</strong> <span class="badge bg-info text-dark">@Model.InfoUsuario.NombreRol</span></p>
                    <p class="mb-2"><strong>NIT Facturación:</strong> <span class="badge bg-light text-dark border">@Model.InfoUsuario.NitFacturacion</span></p>
                    <p class="mb-0"><strong>Límite de Almuerzos:</strong> @Model.InfoUsuario.MaxAlmuerzosPermitidos almuerzos/día</p>
                </div>
            </div>
        </div>

        <!-- Métrica de Consumo Histórico -->
        <div class="col-md-6 col-12 mb-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">💰 Histórico de Consumo</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-6 text-muted">Total Gastado Acumulado:</span>
                        <span class="fs-4 fw-bold text-success">Q @Model.TotalGastadoAcumulado.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-6 text-muted">Platillos Reservados:</span>
                        <span class="badge bg-primary fs-6">@Model.TotalPlatillosReservados unidades</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-6 text-muted">Reservas Canceladas:</span>
                        <span class="badge bg-danger fs-6">@Model.TotalReservasCanceladas veces</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE RESERVAS DEL USUARIO -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">📜 Historial Completo de Reservas de @Model.InfoUsuario.Nombre</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th># Reserva</th>
                            <th>Fecha Consumo</th>
                            <th>Platillo</th>
                            <th>Cantidad</th>
                            <th>Total Pagado</th>
                            <th>Forma Pago</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HistorialReservas != null && Model.HistorialReservas.Any())
                        {
                            @foreach (var res in Model.HistorialReservas)
                            {
                                <tr>
                                    <td><strong>#@res.ReservaId</strong></td>
                                    <td>@res.FechaConsumo.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <div class="fw-bold">@res.NombrePlato</div>
                                        <small class="text-muted">@res.DondeConsume</small>
                                    </td>
                                    <td><span class="badge bg-primary fs-6">@res.Cantidad</span></td>
                                    <td><strong class="text-success">Q @res.TotalPagado.ToString("F2")</strong></td>
                                    <td><span class="badge bg-info text-dark">@res.FormaPago</span></td>
                                    <td>
                                        @if (res.Estado == "Activa")
                                        {
                                            <span class="badge bg-success">Activa</span>
                                        }
                                        else if (res.Estado == "Cancelada")
                                        {
                                            <span class="badge bg-danger">Cancelada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@res.Estado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Este usuario no cuenta con historial de reservaciones registradas.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>