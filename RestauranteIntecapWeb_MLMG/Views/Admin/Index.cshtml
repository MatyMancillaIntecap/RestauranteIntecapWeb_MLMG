@model RestauranteIntecapWeb_MLMG.Models.DTOs.DashboardDTO

@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container-fluid mt-3 mb-5">
    <!-- ENCABEZADO -->
    <div class="row align-items-center mb-4">
        <div class="col-12">
            <h3 class="text-primary fw-bold text-center">👨‍💼 Panel de Administración</h3>
            <p class="text-muted text-center mb-0">Métricas en tiempo real, rendimiento de ventas y control del sistema.</p>
        </div>
    </div>

    <!-- 4 TARJETAS DE MÉTRICAS CON LOS NUEVOS COLORES -->
    <div class="row g-4 mb-5">

        <!-- Tarjeta 1: Platillos de Dieta (Color: Azul claro #ADD8E6) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100" style="background-color: #ADD8E6;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-dark small fw-bold text-uppercase">🥗 Platillos de Dieta</span>
                        <h4 class="fw-bold text-dark mt-2 mb-0">
                            @ViewBag.DietaSolicitados solicitados / @ViewBag.DietaIniciales iniciales
                        </h4>
                    </div>
                    <div class="fs-1 text-primary">🌿</div>
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Platillos Normales (Color: Verde lima claro #9ACD32) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100" style="background-color: #9ACD32;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-dark small fw-bold text-uppercase">🍽️ Platillos Normales</span>
                        <h4 class="fw-bold text-dark mt-2 mb-0">
                            @ViewBag.NormalesSolicitados solicitados / @ViewBag.NormalesIniciales iniciales
                        </h4>
                    </div>
                    <div class="fs-1 text-success">🍛</div>
                </div>
            </div>
        </div>

        <!-- Tarjeta 3: Ventas de Hoy (Color: Naranja coral #FF7F50) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100" style="background-color: #FF7F50;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-white small fw-bold text-uppercase">💰 Ventas de Hoy</span>
                        <h4 class="fw-bold text-white mt-2 mb-0">
                            Q @string.Format("{0:F2}", ViewBag.VentasHoy ?? 0m)
                        </h4>
                    </div>
                    <div class="fs-1 text-warning">💵</div>
                </div>
            </div>
        </div>

        <!-- Tarjeta 4: Reservas de Hoy (Color: Rosa lavanda #FFF0F5) -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100" style="background-color: #FFF0F5;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-dark small fw-bold text-uppercase">🍽️ Reservas de Hoy</span>
                        <h4 class="fw-bold text-dark mt-2 mb-0">
                            @ViewBag.ReservasHoy solicitudes
                        </h4>
                    </div>
                    <div class="fs-1 text-danger">📋</div>
                </div>
            </div>
        </div>

    </div>

    <!-- TARJETA ADICIONAL: USUARIOS (Mantenida de forma limpia) -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-dark text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-light small fw-bold text-uppercase">👥 Usuarios del Sistema</span>
                        <h5 class="fw-bold text-info mt-1 mb-0">
                            @ViewBag.TextoUsuarios
                        </h5>
                    </div>
                    <div class="fs-2">👤</div>
                </div>
            </div>
        </div>
    </div>

    <!-- NUEVA SECCIÓN DE RESUMEN DETALLADO CON FILTRO POR FECHA (Reemplaza los reportes ejecutivos) -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-bold">📊 Resumen Estadístico Detallado por Fecha</h5>
        </div>
        <div class="card-body">
            <!-- Formulario de Filtro por Fecha -->
            <form method="get" asp-action="Index" class="row g-3 align-items-end mb-4">
                <div class="col-md-4 col-12">
                    <label class="form-label small fw-bold">Seleccionar Fecha de Análisis:</label>
                    <input type="date" name="fechaFiltro" class="form-control" value="@ViewBag.FechaFiltroSeleccionada" />
                </div>
                <div class="col-md-2 col-12">
                    <button type="submit" class="btn btn-dark w-100 fw-bold">🔍 Filtrar</button>
                </div>





            



            </form>

            <hr />

            <!-- Tabla o Tarjetas de Resumen con los datos reales obtenidos -->
            <div class="row text-center">
                <div class="col-md-4 mb-3">
                    <div class="p-3 bg-light rounded border">
                        <span class="text-muted small d-block">Total de Ventas en la Fecha</span>
                        <h4 class="fw-bold text-success">Q @string.Format("{0:F2}", ViewBag.VentasHoy ?? 0m)</h4>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="p-3 bg-light rounded border">
                        <span class="text-muted small d-block">Total de Reservas Activas</span>
                        <h4 class="fw-bold text-primary">@ViewBag.ReservasHoy</h4>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="p-3 bg-light rounded border">
                        <span class="text-muted small d-block">Usuarios que Reservaron</span>
                        <h4 class="fw-bold text-dark">@ViewBag.TextoUsuarios</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>