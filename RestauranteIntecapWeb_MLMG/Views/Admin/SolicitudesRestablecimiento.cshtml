@model IEnumerable<RestauranteIntecapWeb_MLMG.Models.DTOs.SolicitudRestablecimientoPasswordDTO>

@{
    ViewData["Title"] = "Solicitudes de Restablecimiento";
    var pendientes = ViewBag.SolicitudesPasswordPendientes ?? 0;
    var correoAsunto = TempData["CorreoAsunto"] as string;
    var correoCuerpo = TempData["CorreoCuerpo"] as string;
}

<div class="container-fluid mt-3 mb-5">
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body bg-light p-3">
            <div class="row align-items-center">
                <div class="col-md-8 col-12">
                    <h3 class="text-primary fw-bold mb-1">🔐 Solicitudes de restablecimiento</h3>
                    <p class="text-muted mb-0">Revisa las solicitudes pendientes y asigna una nueva contraseña de forma segura.</p>
                </div>
                <div class="col-md-4 col-12 text-md-end mt-2 mt-md-0">
                    <span class="badge bg-warning text-dark fs-6 p-2">Solicitudes de contraseña: @pendientes pendientes</span>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show fw-bold" role="alert">
            ⚠️ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Advertencia"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show fw-bold" role="alert">
            ⚠️ @TempData["Advertencia"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show fw-bold" role="alert">
            ✅ @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["CorreoAsunto"] != null && TempData["CorreoCuerpo"] != null)
    {
        <div class="card border-primary shadow-sm mb-4">
            <div class="card-header bg-primary text-white fw-bold">
                Correo listo para copiar y pegar en Outlook
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Asunto</label>
                    <input type="text" class="form-control" readonly value="@correoAsunto" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Cuerpo del correo</label>
                    <textarea class="form-control" rows="12" readonly style="white-space: pre-wrap;">@correoCuerpo</textarea>
                </div>
            </div>
        </div>
    }

    <!-- SECCIÓN DE SOLICITUDES PENDIENTES -->
    @{
        var solicitudesPendientes = Model?.Where(s => s.Estado == "Pendiente").ToList() ?? new List<SolicitudRestablecimientoPasswordDTO>();
        var solicitudesRealizadas = Model?.Where(s => s.Estado == "Realizado" || s.Estado == "Atendida").ToList() ?? new List<SolicitudRestablecimientoPasswordDTO>();
    }

    @if (solicitudesPendientes.Any())
    {
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-warning text-dark fw-bold" style="padding: 1rem;">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">📋 SOLICITUDES PENDIENTES</span>
                    <span class="badge bg-danger">@solicitudesPendientes.Count pendiente@(solicitudesPendientes.Count != 1 ? "s" : "")</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#ID</th>
                                <th>Usuario</th>
                                <th>Correo</th>
                                <th>Fecha solicitud</th>
                                <th>Estado</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in solicitudesPendientes)
                            {
                                <tr class="table-warning">
                                    <td><strong>#@item.Id</strong></td>
                                    <td>@item.NombreUsuario</td>
                                    <td>@item.EmailUsuario</td>
                                    <td>@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">📋 Pendiente</span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-danger fw-bold"
                                                onclick="abrirModalAtencion(@item.Id, '@item.NombreUsuario', '@item.EmailUsuario')">
                                            🔑 Restablecer
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- SECCIÓN DE SOLICITUDES REALIZADAS -->
    @if (solicitudesRealizadas.Any())
    {
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-success text-white fw-bold" style="padding: 1rem;">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">✅ SOLICITUDES REALIZADAS</span>
                    <span class="badge bg-dark">@solicitudesRealizadas.Count realizada@(solicitudesRealizadas.Count != 1 ? "s" : "")</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#ID</th>
                                <th>Usuario</th>
                                <th>Correo</th>
                                <th>Fecha solicitud</th>
                                <th>Fecha atención</th>
                                <th>Atendido por</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in solicitudesRealizadas)
                            {
                                <tr>
                                    <td><strong>#@item.Id</strong></td>
                                    <td>@item.NombreUsuario</td>
                                    <td>@item.EmailUsuario</td>
                                    <td>@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(item.FechaAtencion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                    <td>@(item.NombreAdminAtendio ?? "—")</td>
                                    <td>
                                        <span class="badge bg-success">✅ Realizado</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- MENSAJE SI NO HAY SOLICITUDES -->
    @if (!solicitudesPendientes.Any() && !solicitudesRealizadas.Any())
    {
        <div class="card shadow-sm border-0 rounded-3 text-center">
            <div class="card-body p-5">
                <div class="fs-4 mb-3">📭</div>
                <h5 class="text-muted">No hay solicitudes de restablecimiento registradas</h5>
                <p class="text-muted mb-0">Los usuarios pueden solicitar restablecimiento de contraseña desde la pantalla de login.</p>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalAtencionSolicitud" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">🔐 Restablecer Contraseña</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AtenderSolicitudRestablecimiento" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="SolicitudId" id="solicitud_id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">👤 Usuario</label>
                        <input type="text" id="solicitud_usuario" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">📧 Correo</label>
                        <input type="text" id="solicitud_correo" class="form-control" readonly />
                    </div>
                    <div class="alert alert-info" role="alert">
                        <strong>ℹ️ Información:</strong><br/>
                        La contraseña será restablecida automáticamente a <strong>87654321</strong><br/>
                        El usuario podrá cambiarla después de iniciar sesión.
                    </div>
                    <!-- Campo oculto para NuevaPassword (requerido por el form, pero se ignora en el servidor) -->
                    <input type="hidden" name="NuevaPassword" value="87654321" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-bold">
                        ✅ Confirmar Restablecimiento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalAtencion(id, usuario, correo) {
            document.getElementById('solicitud_id').value = id;
            document.getElementById('solicitud_usuario').value = usuario;
            document.getElementById('solicitud_correo').value = correo;
            const modal = new bootstrap.Modal(document.getElementById('modalAtencionSolicitud'));
            modal.show();
        }
    </script>
}
